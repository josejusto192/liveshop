DATABASE_URL=postgres://postgres:postgres@localhost:5432/liveshop
DATABASE_URL_TEST=postgres://postgres:postgres@localhost:5432/liveshop_test
APP_URL=http://localhost:3000
SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria
# Sem RESEND_API_KEY o código é impresso no terminal do `pnpm dev`.
RESEND_API_KEY=
MAIL_FROM="Live Shop <acesso@dominio.com.br>"
# Vídeo: a tela Transmitir publica por WebRTC/WHIP; o comprador assiste por HLS.
WHIP_BASE_URL=http://localhost:8889
HLS_BASE_URL=http://localhost:8888
# IP/domínio que o navegador usa para alcançar o MediaMTX por UDP (webrtcAdditionalHosts).
MEDIAMTX_PUBLIC_HOST=127.0.0.1
# API interna do MediaMTX (status do sinal na Central) e RTSP interno (pnpm stream:test).
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
# 1 = o player usa o caminho com áudio AAC (toca no Safari do iPhone). 0 = áudio Opus original.
HLS_AUDIO_AAC=1
# TURN é opcional (v1 sem TURN).
TURN_URL=
TURN_USER=
TURN_PASS=
MEDIAMTX_AUTH_SECRET=troque-este-segredo
SUPPORT_WHATSAPP=5511999999999
SUPPORT_EMAIL=suporte@dominio.com.br
UPLOAD_DIR=./uploads
# 1 = registra no terminal cada chamada de autenticação do MediaMTX (diagnóstico da transmissão).
DEBUG_MEDIAMTX_AUTH=0
